# Copy this file to .env, then fill in only the providers you plan to use.
# Values in the real process environment override values in .env.

# Image generation and image-to-prompt reverse prompting.
# Required for scripts/generate_image.py and scripts/reverse_prompt.py.
NANO_BANANA_API_KEY=your_api_key_here
NANO_BANANA_BASE_URL=https://your-provider.example/v1

# Optional model overrides.
NANO_BANANA_IMAGE_MODEL=gemini-3.1-flash-image-preview
NANO_BANANA_REVERSE_MODEL=gemini-3.1-pro-preview

# Optional SkyReels image-to-video batch generation.
SKYREELS_API_KEY=your_skyreels_api_key_here
SKYREELS_BASE_URL=https://api-gateway.skyreels.ai/api/v1
# Advanced overrides; normally leave these commented unless your provider differs.
# SKYREELS_SUBMIT_URL=https://api-gateway.skyreels.ai/api/v1/video/image2video/submit
# SKYREELS_TASK_URL=https://api-gateway.skyreels.ai/api/v1/video/image2video/task/{task_id}

# Optional upload-service overrides used by scripts/ava_skyreels_batch.py.
TMPFILES_UPLOAD_URL=https://tmpfiles.org/api/v1/upload
CATBOX_UPLOAD_URL=https://catbox.moe/user/api.php
